.gitignore

# Node.js dependencies
/node_modules
**/node_modules

# Environment files
.env
*.env
backend/.env
.package-lock.json
yarn.lock

# Database files
*.db
database.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code settings
.vscode/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Ignore local frontend assets cache or temp folders
uploads/
